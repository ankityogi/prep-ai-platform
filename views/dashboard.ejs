<!DOCTYPE html>
<html>

<head>
    <title>PrepAI Home</title>
    <link rel="stylesheet" href="style.css">
    <style>
        @keyframes subtleBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }
    </style>
</head>

<body>
    <!-- Unified Top Navbar -->
    <%- include('partials/navbar', { activePage: 'dashboard' }) %>


        <div class="app-container">

            <!-- Main Content -->
            <main class="main-content">

                <!-- Welcome Banner -->
                <div style="background: linear-gradient(135deg, var(--primary), #1e3a8a); color: white; padding: 40px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
                    <div>
                        <h1 style="color: white; margin-bottom: 10px;">Welcome to PrepAI 👋</h1>
                        <p style="opacity: 0.9; font-size: 16px;">Your personal command center for technical interview preparation.</p>
                    </div>
                    <div id="streakBadge" style="display: none; background: rgba(255, 255, 255, 0.15); padding: 10px 25px; border-radius: 50px; border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); animation: subtleBounce 2s ease-in-out infinite;">
                        <h2 style="color: #fca5a5; margin: 0; font-size: 24px;">🔥 <span id="streakCount">0</span> Day Streak!</h2>
                    </div>
                </div>

                <h2 style="margin-bottom: 20px;">Quick Actions</h2>
                <div class="card-grid" style="margin-top: 0;">

                    <a href="/ats-scanner" class="card" style="border-top: 4px solid #ef4444;">
                        <h3>📈 ATS Resume Score</h3>
                        <p>Calculate your precise match percentage against any Job Description.</p>
                    </a>

                    <a href="/mock-test-home" class="card" style="border-top: 4px solid var(--primary);">
                        <h3>📝 AI Mock Test</h3>
                        <p>Start a 10-minute AI-graded test on specific CS topics or your own JD.</p>
                    </a>

                    <a href="/coding" class="card" style="border-top: 4px solid #10b981;">
                        <h3>💻 Practice Coding</h3>
                        <p>Hone your programming skills across dynamic tech domains.</p>
                    </a>

                    <a href="/interview" class="card" style="border-top: 4px solid #f59e0b;">
                        <h3>🎙️ Start AI Interview</h3>
                        <p>Practice verbal and behavioral questions with the AI coach.</p>
                    </a>

                    <a href="/profile" class="card" style="border-top: 4px solid #8b5cf6;">
                        <h3>📄 Manage Profile</h3>
                        <p>Upload your resume to unlock hyper-personalized AI questions.</p>
                    </a>

                </div>

                <div class="card" onclick="startLiveInterview()" style="cursor:pointer; text-align: center; margin-top: 30px; background: #faf5ff; border: 2px dashed #a855f7;">
                    <h3 style="color: #7e22ce;">🤝 Peer-to-Peer Interview Room</h3>
                    <p style="color: #6b21a8;">Generate a Live 1-to-1 Video room link to practice with a human peer.</p>
                </div>

            </main>

        </div>
        <script>
            function startLiveInterview() {
                window.location.href = "/live-interview";
            }
            
            async function fetchGamificationData() {
                try {
                    const res = await fetch("/api/profile");
                    if(res.ok) {
                        const user = await res.json();
                        if (user.currentStreak && user.currentStreak > 0) {
                            document.getElementById("streakBadge").style.display = "block";
                            document.getElementById("streakCount").innerText = user.currentStreak;
                        }
                    }
                } catch (e) { console.error("Could not load gamification streak"); }
            }
            
            // Hydrate Gamification UI instantly on load
            fetchGamificationData();
        </script>
</body>


</html>