<!DOCTYPE html>
<html>

<head>
    <title>PrepAI Home</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <!-- Unified Top Navbar -->
    <%- include('partials/navbar', { activePage: 'dashboard' }) %>


        <div class="app-container">

            <!-- Main Content -->
            <main class="main-content">

                <!-- Welcome Banner -->
                <div style="background: linear-gradient(135deg, var(--primary), #1e3a8a); color: white; padding: 40px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                    <h1 style="color: white; margin-bottom: 10px;">Welcome to PrepAI 👋</h1>
                    <p style="opacity: 0.9; font-size: 16px;">Your personal command center for technical interview preparation.</p>
                </div>

                <h2 style="margin-bottom: 20px;">Quick Actions</h2>
                <div class="card-grid" style="margin-top: 0;">

                    <a href="/mock-test-home" class="card" style="border-top: 4px solid var(--primary);">
                        <h3>📝 AI Mock Test</h3>
                        <p>Start a 10-minute AI-graded test on specific CS topics or your own JD.</p>
                    </a>

                    <a href="/coding" class="card" style="border-top: 4px solid #10b981;">
                        <h3>💻 Practice Coding</h3>
                        <p>Hone your programming skills across dynamic tech domains.</p>
                    </a>

                    <a href="/interview" class="card" style="border-top: 4px solid #f59e0b;">
                        <h3>🎙️ Start AI Interview</h3>
                        <p>Practice verbal and behavioral questions with the AI coach.</p>
                    </a>

                    <a href="/resume" class="card" style="border-top: 4px solid #8b5cf6;">
                        <h3>📄 Manage Profile</h3>
                        <p>Upload your resume to unlock hyper-personalized AI questions.</p>
                    </a>

                </div>

                <div class="card" onclick="startLiveInterview()" style="cursor:pointer; text-align: center; margin-top: 30px; background: #faf5ff; border: 2px dashed #a855f7;">
                    <h3 style="color: #7e22ce;">🤝 Peer-to-Peer Interview Room</h3>
                    <p style="color: #6b21a8;">Generate a Live 1-to-1 Video room link to practice with a human peer.</p>
                </div>

            </main>

        </div>
        <script>
            function startLiveInterview() {
                window.location.href = "/live-interview";
            }
        </script>
</body>


</html>