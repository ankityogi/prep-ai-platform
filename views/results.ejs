<!DOCTYPE html>
<html>

<head>
    <title>Analytics Dashboard</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }
        .chart-container {
            background: var(--surface);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            position: relative;
            height: 350px;
            width: 100%;
        }
        .stat-card {
            background: linear-gradient(145deg, var(--surface) 0%, rgba(30, 41, 59, 0.4) 100%);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 10px;
        }
        .stat-card h3 { font-size: 16px; color: var(--text-muted); margin: 0; }
        .stat-card h1 { font-size: 48px; color: var(--primary); margin: 0; font-weight: 800; }
        
        .history-feed {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .history-card {
            background: var(--surface);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
        }
        .history-header .badge {
            background: rgba(99, 102, 241, 0.2);
            color: var(--primary);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .history-score {
            font-size: 20px;
            font-weight: 700;
            color: var(--success, #22c55e);
        }
        .history-question { font-size: 16px; font-weight: 500; }
        .history-feedback { font-size: 14px; color: var(--text-muted); background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px;}
        
        .history-feedback * { margin-bottom: 10px; }
        .history-feedback *:last-child { margin-bottom: 0; }

        @media (max-width: 768px) {
            .dashboard-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar', { activePage: 'results' }) %>

    <div class="app-container">
        <main class="main-content">
            <h1 style="margin-bottom: 10px;">Results & Analytics</h1>
            <p class="subtitle" style="margin-bottom: 30px;">Track your interview progress and view detailed feedback from past sessions.</p>

            <div class="dashboard-grid">
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div class="chart-container">
                        <canvas id="performanceChart"></canvas>
                    </div>
                    <div class="chart-container">
                        <canvas id="mockTestTrendChart"></canvas>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div class="stat-card">
                        <h3>Average AI Score</h3>
                        <h1 id="avgScore">--</h1>
                        <p style="font-size: 13px; color: var(--text-muted);">Out of 10 points</p>
                    </div>
                    <div class="stat-card">
                        <h3>Mock Tests Taken</h3>
                        <h1 id="totalTests">--</h1>
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; padding-bottom: 0px;">Your Performance Results</h2>
                <a href="/api/results/export" class="btn btn-warning" target="_blank">
                    📄 Export Full PDF Report
                </a>
            </div>
            <div class="history-feed" id="historyFeed">
                <p style="color: var(--text-muted);">Loading your past sessions...</p>
            </div>
        </main>
    </div>

    <script>
        async function loadAnalytics() {
            try {
                const response = await fetch('/api/results/data');
                const data = await response.json();
                
                const evaluations = data.evaluations || [];
                const mockTests = data.mockTests || [];
                
                // --- Top Level Stats ---
                document.getElementById('totalTests').innerText = mockTests.length;
                
                let totalScore = 0;
                evaluations.forEach(ev => totalScore += ev.score);
                const avg = evaluations.length > 0 ? (totalScore / evaluations.length).toFixed(1) : 0;
                document.getElementById('avgScore').innerText = avg || '--';

                // --- Chart Construction ---
                const ctx = document.getElementById('performanceChart').getContext('2d');
                
                const labels = evaluations.map((ev, i) => `Session ${i+1} (${new Date(ev.createdAt).toLocaleDateString()})`);
                const scores = evaluations.map(ev => ev.score);
                
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels.length ? labels : ['No Data Yet'],
                        datasets: [{
                            label: 'AI Evaluation Score',
                            data: scores.length ? scores : [0],
                            borderColor: '#6366f1',
                            backgroundColor: 'rgba(99, 102, 241, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#6366f1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { min: 0, max: 10, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                            x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                        },
                        plugins: {
                            legend: { labels: { color: '#f8fafc' } }
                        }
                    }
                });

                // --- Mock Test Trend Chart ---
                const ctxMock = document.getElementById('mockTestTrendChart').getContext('2d');
                
                const mockLabels = mockTests.map((t, i) => `Test ${i+1} (${new Date(t.createdAt).toLocaleDateString()})`);
                const mockScores = mockTests.map(t => t.score);
                
                new Chart(ctxMock, {
                    type: 'line',
                    data: {
                        labels: mockLabels.length ? mockLabels : ['No Data Yet'],
                        datasets: [{
                            label: 'Mock Test Trend',
                            data: mockScores.length ? mockScores : [0],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#10b981'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { min: 0, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                            x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                        },
                        plugins: {
                            legend: { labels: { color: '#f8fafc' } },
                            title: { display: true, text: '30-Day Historical Trend', color: '#f8fafc' }
                        }
                    }
                });

                // --- History Feed Construction ---
                const feedContainer = document.getElementById('historyFeed');
                feedContainer.innerHTML = '';
                
                if (evaluations.length === 0) {
                    feedContainer.innerHTML = '<p style="color: var(--text-muted);">You have not completed any AI Interviews or Coding Sessions yet.</p>';
                }

                // Render in reverse chronological order
                [...evaluations].reverse().forEach(ev => {
                    const card = document.createElement('div');
                    card.className = 'history-card';
                    card.innerHTML = `
                        <div class="history-header">
                            <span class="badge">${ev.type === 'code' ? 'Coding Test' : 'Interview Round'}</span>
                            <span class="history-score">Score: ${ev.score}/10</span>
                        </div>
                        <div class="history-question">Q: ${ev.question}</div>
                        <div class="history-feedback">${marked.parse(ev.feedback || "No feedback available.")}</div>
                        <div style="font-size: 12px; color: var(--text-muted); margin-top: 5px;">
                            Submitted ${new Date(ev.createdAt).toLocaleString()}
                        </div>
                    `;
                    feedContainer.appendChild(card);
                });

            } catch (err) {
                console.error("Failed to load analytics", err);
                document.getElementById('historyFeed').innerHTML = '<p style="color: #ef4444;">Error loading history data.</p>';
            }
        }

        window.onload = loadAnalytics;
    </script>
</body>
</html>