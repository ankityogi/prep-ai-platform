<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>AI ATS Resume Scanner</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .ats-container {
            max-width: 900px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .ats-panel {
            background: var(--surface);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        .ats-header {
            background: linear-gradient(135deg, #8b5cf6, #4c1d95);
            color: white;
            padding: 40px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        textarea.jd-input {
            width: 100%;
            height: 250px;
            padding: 15px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 15px;
            resize: vertical;
            margin-bottom: 20px;
            font-family: inherit;
        }

        textarea.jd-input:focus {
            border-color: #8b5cf6;
            outline: none;
        }

        .scan-btn {
            background-color: #8b5cf6; /* Purple Theme */
            color: white;
            padding: 15px 30px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s;
        }
        
        .scan-btn:hover {
            background-color: #7c3aed;
        }

        .output-box {
            display: none;
            margin-top: 30px;
            padding: 25px;
            background: #f8fafc;
            border-left: 5px solid #8b5cf6;
            border-radius: 8px;
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: conic-gradient(#8b5cf6 0%, #e2e8f0 0%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 20px auto;
            font-size: 32px;
            font-weight: bold;
            color: #1e293b;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.05);
        }

        .score-circle-inner {
            width: 120px;
            height: 120px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .keyword-chip {
            display: inline-block;
            background: #fee2e2;
            color: #991b1b;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            margin: 5px;
            font-weight: bold;
            border: 1px solid #fca5a5;
        }

        .loading-overlay {
            display: none;
            text-align: center;
            color: #8b5cf6;
            font-weight: bold;
            font-size: 18px;
            margin: 20px 0;
        }

        .spinner {
            border: 4px solid rgba(0,0,0,0.1);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border-left-color: #8b5cf6;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-bottom: 10px;
        }

        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>

<body>

    <%- include('partials/navbar', { activePage: 'ats-scanner' }) %>

    <div class="main-layout">
        <main class="main-content" style="max-width: 1000px;">

            <div class="ats-header">
                <h1 style="color: white; margin-bottom: 10px;">📄 AI ATS Resume Scanner</h1>
                <p style="opacity: 0.9; font-size: 16px;">Paste a Target Job Description below. Our strict AI Applicant Tracking System will compare it against your currently saved uploaded Profile Resume and calculate your exact Match Percentage.</p>
            </div>

            <div class="ats-container">
                <div class="ats-panel">
                    <h3>🎯 Target Job Description</h3>
                    <p style="color: var(--text-muted); margin-bottom: 15px;">Paste the exact requirements, skills, and duties here.</p>
                    
                    <textarea id="jd" class="jd-input" placeholder="e.g. We are looking for a Software Engineer with 3 years of React experience..."></textarea>
                    
                    <button class="scan-btn" id="scanBtn" onclick="runATSScan()">Run Strict ATS Scan</button>
                    
                    <div class="loading-overlay" id="loadingDiv">
                        <div class="spinner"></div><br>
                        AI is scraping your resume against the JD...
                    </div>
                </div>

                <div class="ats-panel output-box" id="resultOutput">
                    
                    <h2 style="text-align: center; margin-bottom: 10px;">ATS Match Score</h2>
                    <div class="score-circle" id="scoreChart">
                        <div class="score-circle-inner" id="scoreValue">0%</div>
                    </div>

                    <div style="margin-top: 30px;">
                        <h3 style="color: #991b1b; border-bottom: 2px solid #fecaca; padding-bottom: 10px; margin-bottom: 15px;">🚨 Critical Missing Keywords</h3>
                        <p style="color: #64748b; font-size: 14px; margin-bottom: 15px;">Your resume does not explicitly mention these required technologies from the JD. Add them to pass the ATS filter:</p>
                        <div id="keywordsContainer">
                             <!-- Chips go here -->
                        </div>
                    </div>

                    <div style="margin-top: 30px;">
                        <h3 style="color: #1e293b; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 15px;">💡 Strategy Feedback</h3>
                        <p id="atsFeedback" style="line-height: 1.6; color: #334155;"></p>
                    </div>

                </div>
            </div>

        </main>
    </div>

    <script>
        async function runATSScan() {
            const jd = document.getElementById("jd").value;
            if (jd.length < 50) {
                alert("Please paste a detailed Job Description (minimum 50 characters).");
                return;
            }

            document.getElementById("scanBtn").style.display = "none";
            document.getElementById("loadingDiv").style.display = "block";
            document.getElementById("resultOutput").style.display = "none";

            try {
                const res = await fetch("/api/ats/score", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ jobDescription: jd })
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.error || "Failed to run scan. Have you uploaded a resume in your Profile?");
                    document.getElementById("scanBtn").style.display = "block";
                    document.getElementById("loadingDiv").style.display = "none";
                    return;
                }

                // Render Score
                const scoreChart = document.getElementById("scoreChart");
                const scoreValue = document.getElementById("scoreValue");
                const score = parseInt(data.score) || 0;
                
                scoreValue.innerText = score + "%";
                
                // Set color dynamically based on score
                let color = "#ef4444"; // Red (Bad)
                if (score > 40) color = "#f59e0b"; // Orange (Okay)
                if (score > 75) color = "#10b981"; // Green (Excellent)
                
                scoreChart.style.background = `conic-gradient(${color} ${score}%, #e2e8f0 ${score}%)`;

                // Render Keywords
                const keywordsContainer = document.getElementById("keywordsContainer");
                keywordsContainer.innerHTML = "";
                if (data.missingKeywords && data.missingKeywords.length > 0) {
                    data.missingKeywords.forEach(kw => {
                        const span = document.createElement("span");
                        span.className = "keyword-chip";
                        span.innerText = kw;
                        keywordsContainer.appendChild(span);
                    });
                } else {
                    keywordsContainer.innerHTML = "<p style='color:green; font-weight:bold;'>Awesome! You hit all the major keywords.</p>";
                }

                // Render Feedback
                document.getElementById("atsFeedback").innerText = data.feedback;

                document.getElementById("loadingDiv").style.display = "none";
                document.getElementById("resultOutput").style.display = "block";
                document.getElementById("scanBtn").style.display = "block";
                document.getElementById("scanBtn").innerText = "Scan Another JD";

            } catch (err) {
                console.error(err);
                alert("A network error occurred. Please try again.");
                document.getElementById("scanBtn").style.display = "block";
                document.getElementById("loadingDiv").style.display = "none";
            }
        }
    </script>
</body>
</html>
